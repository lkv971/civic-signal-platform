relationship 'Buyers to Opportunities'
	fromColumn: opportunity.buyer_key
	toColumn: buyer.buyer_key

relationship 'Sources to Opportunities'
	fromColumn: opportunity.source_system
	toColumn: source.'Source Code'

relationship 'Procurement Category to Opportunities'
	fromColumn: opportunity.category_id
	toColumn: procurement_category.category_id

relationship 'Date to Opportunities by Published Date'
	fromColumn: opportunity.'Published Date'
	toColumn: date.Date

relationship 'Date to Opportunities by Closing Date'
	isActive: false
	fromColumn: opportunity.'Closing Date'
	toColumn: date.Date

relationship 'Opportunities to Duplicate Candidates'
	fromColumn: opportunity_duplicate_candidate.opportunity_key
	toColumn: opportunity.opportunity_key

