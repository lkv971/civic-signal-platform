model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - WH_CivicSignal_Gold"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","MCP-PBIModeling","WebModelingEdit","CopilotTooling"]

ref table Date
ref table Source
ref table Buyer
ref table 'Procurement Category'
ref table Opportunities
ref table 'Duplicate Candidates'

ref cultureInfo en-US

