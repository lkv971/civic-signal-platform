table Opportunities
	lineageTag: 72f9d3d0-838f-46c1-a319-705873007fd8
	sourceLineageTag: [fact].[opportunity]

	/// Number of opportunity records in the current filter context.
	measure 'Opportunity Count' = COUNTROWS('Opportunities')
		formatString: #,##0
		displayFolder: Counts
		lineageTag: baef17f4-0b53-4112-a6ce-e6baaadc4d13

	/// Number of opportunities whose current status is Open.
	measure 'Open Opportunities' =
			CALCULATE(
			    [Opportunity Count],
			    'Opportunities'[status] = "Open"
			)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: a23a5bea-d6df-4748-a02f-437706bda0ba

	/// Number of opportunities whose current status is Awarded.
	measure 'Awarded Opportunities' =
			CALCULATE(
			    [Opportunity Count],
			    'Opportunities'[status] = "Awarded"
			)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: ed4798c9-af90-4e80-84ca-ad4b5cfb9949

	/// Number of opportunities whose current status is Cancelled.
	measure 'Cancelled Opportunities' =
			CALCULATE(
			    [Opportunity Count],
			    'Opportunities'[status] = "Cancelled"
			)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: f003b538-b1f3-4c97-92d9-1a1fe8577eb4

	/// Number of opportunities flagged as potential duplicate candidates.
	measure 'Duplicate Candidate Opportunities' =
			CALCULATE(
			    [Opportunity Count],
			    'Opportunities'[potential_duplicate_flag] = TRUE()
			)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: a6729976-78e1-42a5-bb5b-a6854e2156bc

	/// Sum of estimated opportunity value in the current filter context; interpret with currency_code.
	measure 'Estimated Opportunity Value' = SUM('Opportunities'[estimated_value])
		formatString: #,##0.##
		displayFolder: Value
		lineageTag: e5eef717-c86c-4ace-a263-a48abb944af5

	/// Average estimated opportunity value in the current filter context; interpret with currency_code.
	measure 'Average Estimated Value' = AVERAGE('Opportunities'[estimated_value])
		formatString: #,##0.##
		displayFolder: Value
		lineageTag: 8ebc8d58-7f3b-4360-bd8e-4504eb7e2569

	/// Average number of days from publication to closing date.
	measure 'Average Days To Close' = AVERAGE('Opportunities'[days_to_close])
		formatString: #,##0.00
		displayFolder: Cycle Time
		lineageTag: befc7ab9-c5b6-478d-bd5c-7cccb3092033

	/// Number of opportunities whose normalized category is missing.
	measure 'Opportunities Missing Category' =
			CALCULATE(
			    [Opportunity Count],
			    'Opportunities'[category_quality_status] = "MISSING"
			)
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 493dd8b8-b416-403f-87da-9d64725858ff

	/// Number of distinct buyers represented by opportunities in the current filter context.
	measure 'Distinct Buyers' = DISTINCTCOUNT('Opportunities'[buyer_key])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 34725065-ad0a-4c8a-a008-895f53e78b3c

	/// Number of distinct source systems represented by opportunities in the current filter context.
	measure 'Distinct Sources' = DISTINCTCOUNT('Opportunities'[source_system])
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 9cea31e6-17b6-4193-9eba-345b7f449100

	/// Number of opportunities evaluated by closing date through the inactive Date relationship.
	measure 'Closing Opportunity Count' =
			CALCULATE(
			    [Opportunity Count],
			    USERELATIONSHIP(
			        'Date'[date_value],
			        'Opportunities'[closing_date]
			    )
			)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 229f7833-0244-49d4-83b7-39a955217706

